# Copy to .env (gitignored). EXPO_PUBLIC_* values are bundled into the app,
# so only put public keys here — never secret keys.

# RevenueCat → Project settings → API keys → "Public app-specific API keys"
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe → Developers → API keys → Publishable key. Use pk_test_... while testing.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-side secrets do NOT go here. Set them on the Supabase Edge Function:
#   supabase secrets set REVENUECAT_SECRET_KEY=sk_... REVENUECAT_WEBHOOK_AUTH=<long random string>
#   supabase secrets set STRIPE_SECRET_KEY=sk_... STRIPE_WEBHOOK_SECRET=whsec_...
